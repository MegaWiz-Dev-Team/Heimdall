<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asgard.heimdall-llama</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{HOMEBREW_PREFIX}}/bin/llama-server</string>
        <string>-m</string>
        <string>{{PROJECT_DIR}}/models/bge-m3-Q8_0.gguf</string>
        <string>--port</string>
        <string>8089</string>
        <string>--embedding</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{PROJECT_DIR}}/logs/heimdall-llama-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{PROJECT_DIR}}/logs/heimdall-llama-stderr.log</string>
    <key>WorkingDirectory</key>
    <string>{{PROJECT_DIR}}</string>
</dict>
</plist>
