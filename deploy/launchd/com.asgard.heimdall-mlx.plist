<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asgard.heimdall-mlx</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PROJECT_DIR}}/.venv/bin/python</string>
        <string>-m</string>
        <string>mlx_lm.server</string>
        <!-- cwd-relative symlink to the pinned HF snapshot of
             mlx-community/gemma-4-26b-a4b-it-4bit; a missing link makes
             mlx_lm treat the name as a repo id and generation hangs -->
        <string>--model</string>
        <string>gemma-4-26b</string>
        <string>--port</string>
        <string>8081</string>
        <!-- Cross-tenant system-prompt KV reuse (docs/admission-and-kv-reuse.md,
             Tier 2). Each request stores up to 3 caches (system, user,
             assistant); the default cap of 10 left ~3 system prefixes, so a
             rotation of tenants evicted each other and never hit. The byte cap
             bounds the cache, which is unbounded by default. -->
        <string>--prompt-cache-size</string>
        <string>64</string>
        <string>--prompt-cache-bytes</string>
        <string>4GB</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{PROJECT_DIR}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{HOME}}</string>
        <key>TOKENIZERS_PARALLELISM</key>
        <string>false</string>
    </dict>

    <!-- Auto-restart on crash -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Model loading takes time, throttle restart to 30s -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Start automatically at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>{{PROJECT_DIR}}/logs/mlx-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{PROJECT_DIR}}/logs/mlx-stderr.log</string>
</dict>
</plist>
