# ============================================
# LLM Server Configuration
# Copy to .env and modify as needed
# ============================================

# --- Engine Configuration ---
# Backend engine host and port (where mlx_lm/llama.cpp runs)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8081

# Default model for mlx_lm
LLM_MODEL=mlx-community/Qwen3.5-35B-A3B-4bit

# Memory fraction for GPU (0.0-1.0)
VLLM_METAL_MEMORY_FRACTION=0.85

# --- Gateway Configuration ---
# Gateway listen address
HOST=0.0.0.0
GATEWAY_PORT=8080

# API Keys (comma-separated, leave empty to disable auth)
# API_KEYS=key1,key2,key3

# --- Logging ---
RUST_LOG=heimdall_gateway=info,tower_http=info

# --- Model Storage ---
# External SSD path for archiving unused models
# EXTERNAL_MODEL_DIR=/Volumes/T7 Shield/Development/AI_Models
